# Environment Variables Template

# Node environment
NODE_ENV=development

# ===========================================
# TinaCMS Cloud Configuration
# ===========================================
# Ottieni questi valori da https://app.tina.io/
# 1. Crea un progetto su Tina Cloud
# 2. Collega il repository GitHub
# 3. Genera un Read-Only Token per il frontend
# 4. Copia Client ID e Token qui sotto

# Server-side credentials (used during build)
TINA_CLIENT_ID=your-client-id-here
TINA_TOKEN=your-token-here
TINA_BRANCH=main

# Client-side credentials (exposed to browser for admin panel)
NEXT_PUBLIC_TINA_CLIENT_ID=your-client-id-here
NEXT_PUBLIC_TINA_TOKEN=your-token-here
NEXT_PUBLIC_TINA_BRANCH=main

# Search Token (opzionale - per la ricerca nel CMS)
# TINA_SEARCH_TOKEN=your-search-token
# NEXT_PUBLIC_TINA_SEARCH_TOKEN=your-search-token

# ===========================================
# Site Configuration
# ===========================================
NEXT_PUBLIC_SITE_URL=https://1908-shop.vercel.app
NEXT_PUBLIC_SITE_NAME=1908 Shop
NEXT_PUBLIC_CONTACT_EMAIL=info@1908shop.com
NEXT_PUBLIC_INSTAGRAM_USERNAME=1908shop_

# Analytics (optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
